{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./data/providers.local.json)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat data/providers.local.json)",
      "Bash(cat ./data/providers.local.json)"
    ]
  }
}
