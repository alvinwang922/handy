# Copy to .env.local (gitignored — the repo is shared with judges, never commit keys).
# Mock flags let every module run without keys; flip each to 0 as its real integration lands.
MOCK_DIAL=1
MOCK_CLAUDE=1
MOCK_CLAUDE_EXTRACT=1           # with MOCK_CLAUDE=0: real photo diagnosis, mock transcript extraction
MOCK_PARTS=1                    # with MOCK_CLAUDE=0: 0 = real DIY part search (Claude web search, up to 5 searches per DIY request)
MOCK_KEEWANO=1

MAX_CONCURRENT_CALLS=2          # Dial free tier cap; raise after redeeming DIAL_FOR_SPEEDHACKS credit
COMPANY_NAME=Maple Property Management
QUOTE_CALL_MAX_SEC=240
BOOKING_CALL_MAX_SEC=180

# Claude (P2)
ANTHROPIC_API_KEY=

# Dial (P1) — getdial.ai → Settings (API key) / Numbers (number id)
DIAL_API_KEY=
DIAL_FROM_NUMBER_ID=
DIAL_ALLOWED_RECIPIENTS=
DIAL_FROM_NUMBER=               # E.164, used as the callback number in voicemails
DIAL_RECEPTIONIST_NUMBER_ID=    # 2nd number that plays the "Bay Area Rooter" AI receptionist
DIAL_RECEPTIONIST_API_KEY=      # optional: if that number lives on a teammate's Dial account

# Keewano (P4) — Settings → Project → API Keys / Personal → Security / Details → Project ID
KEEWANO_API_KEY=
KEEWANO_PAT=
KEEWANO_EMAIL=
KEEWANO_PROJECT_ID=
